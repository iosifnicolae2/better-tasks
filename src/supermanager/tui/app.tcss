Screen { layout: vertical; }

#topbar { height: 1; background: $panel; }

#tabs { height: 1fr; }
TabPane { padding: 0; }

#agents-table, #tasks-table { height: 1fr; }
#detail-box { height: 12; border-top: solid $primary-darken-2; padding: 0 1; }

#events { height: 6; border-top: solid $warning-darken-3; padding: 0 1; }

ModalScreen { align: center middle; }
#dialog {
    width: 90%; max-width: 110; height: auto; max-height: 95%;
    border: thick $primary; background: $surface; padding: 1 2;
}
#dialog Label { margin-top: 1; color: $text-muted; }
#dialog TextArea { height: 5; }
#dialog #problem { height: 7; }
.setting { height: 3; }
.setting-label { width: 1fr; padding-right: 2; }
.setting Switch { width: auto; }
.setting Select { width: 24; }
.setting-input { width: 24; }

#confirm { width: 70; height: auto; border: thick $warning; background: $surface; padding: 1 2; }
#help { width: 100; height: auto; border: thick $secondary; background: $surface; padding: 1 2; }
